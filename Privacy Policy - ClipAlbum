            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 40px;
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
        }

        header {
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        h1 {
            color: #0f172a;
            font-size: 2.2rem;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .meta-date {
            color: #64748b;
            font-size: 0.95rem;
        }

        .meta-date strong {
            color: #475569;
        }

        /* Callout / Highlight Box */
        .highlight-box {
            background-color: var(--accent-bg);
            border-left: 4px solid var(--primary-color);
            padding: 20px;
            border-radius: 0 8px 8px 0;
            margin: 25px 0;
        }

        .highlight-box p {
            margin: 0;
            font-size: 1.05rem;
            color: #1e40af;
            font-weight: 500;
        }

        /* Navigation Index */
        .nav-box {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
        }

        .nav-box h3 {
            margin-top: 0;
            color: #334155;
            font-size: 1.1rem;
        }

        .nav-list {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            display: grid;
            gap: 8px;
            padding-left: 0;
            list-style: none;
        }

        .nav-list a {
            color: var(--primary-color);
            text-decoration: none;
            font-size: 0.95rem;
        }

        .nav-list a:hover {
            text-decoration: underline;
        }

        /* Headings */
        h2 {
            color: #0f172a;
            font-size: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
            margin-top: 40px;
        }

        h3 {
            color: #334155;
            font-size: 1.15rem;
            margin-top: 25px;
        }

        p, li {
            font-size: 1rem;
            color: #334155;
        }

        ul {
            padding-left: 20px;
        }

        li {
            margin-bottom: 8px;
        }

        /* Tables */
        .table-responsive {
            overflow-x: auto;
            margin: 25px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.95rem;
        }

        th, td {
            padding: 12px 16px;
            border: 1px solid var(--border-color);
        }

        th {
            background-color: #f1f5f9;
            color: #1e293b;
            font-weight: 600;
        }

        tr:nth-child(even) {
            background-color: #f8fafc;
        }

        /* Contact Details */
        .contact-list {
            list-style: none;
            padding-left: 0;
        }

        .contact-list li {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .contact-list .icon {
            margin-right: 10px;
            font-size: 1.1rem;
        }

        footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                margin: 0;
                padding: 20px;
                border-radius: 0;
            }
            .nav-list {
                grid-template-columns: 1fr;
            }
